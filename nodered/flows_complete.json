    {
        "id": "function_router_salles",
        "type": "function",
        "z": "tab_multi_salles",
        "name": "Router par salle",
        "func": "const data = msg.payload;\nconst salle = data.salle;\n\n// Créer un message pour chaque salle\nreturn [\n    salle === 'A101' ? msg : null,\n    salle === 'A102' ? msg : null,\n    salle === 'B201' ? msg : null,\n    salle === 'B202' ? msg : null,\n    salle === 'C301' ? msg : null\n];",
        "outputs": 5,
        "noerr": 0,
        "x": 320,
        "y": 100,
        "wires": [
