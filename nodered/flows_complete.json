    {
        "id": "function_update_config",
        "type": "function",
        "z": "tab_configuration",
        "name": "Sauvegarder Configuration",
        "func": "// Stocker la configuration dans le contexte global\nconst config = global.get('iot_config') || {};\n\nif (msg.topic === 'config/seuil_temp_max') {\n    config.seuil_temp_max = msg.payload;\n} else if (msg.topic === 'config/seuil_temp_min') {\n    config.seuil_temp_min = msg.payload;\n} else if (msg.topic === 'config/seuil_luminosite') {\n    config.seuil_luminosite = msg.payload;\n} else if (msg.topic === 'config/controle_auto') {\n    config.controle_auto = msg.payload;\n} else if (msg.topic === 'config/alertes_email') {\n    config.alertes_email = msg.payload;\n}\n\nglobal.set('iot_config', config);\n\n// Publier sur MQTT pour que Python reçoive la config\nmsg.payload = JSON.stringify(config);\nmsg.topic = 'salle_classe/configuration';\n\nnode.status({fill:\"green\",shape:\"dot\",text:\"Config mise à jour\"});\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 420,
        "y": 225,
        "wires": [
            [
                "mqtt_out_config",
                "text_config_status"
            ]
        ]
    },
