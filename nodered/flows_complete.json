    {
        "id": "function_alert",
        "type": "function",
        "z": "main_flow",
        "name": "Logique Alertes",
        "func": "const data = msg.payload;\nlet alertes = [];\n\n// Alerte température trop élevée\nif (data.temperature > 25) {\n    alertes.push('⚠️ Température élevée: ' + data.temperature + '°C');\n}\n\n// Alerte température trop basse\nif (data.temperature < 19) {\n    alertes.push('❄️ Température basse: ' + data.temperature + '°C');\n}\n\n// Alerte luminosité insuffisante si salle occupée\nif (data.salle_occupee && data.luminosite < 300) {\n    alertes.push('🔦 Luminosité insuffisante: ' + data.luminosite + ' lux');\n}\n\n// Alerte salle occupée avec beaucoup de monde\nif (data.presence > 25) {\n    alertes.push('👥 Salle presque pleine: ' + data.presence + ' personnes');\n}\n\nif (alertes.length > 0) {\n    msg.payload = alertes.join(' | ');\n    return msg;\n}\n\nreturn null;",
        "outputs": 1,
        "noerr": 0,
        "x": 400,
        "y": 450,
        "wires": [
            [
                "text_alert"
            ]
        ]
    },
